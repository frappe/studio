{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SortByProps": {
      "type": "object",
      "properties": {
        "doctype": {
          "type": "string",
          "description": "Doctype whose Meta drives the sortable field options."
        },
        "hideLabel": {
          "type": "boolean",
          "description": "Hide the \"Sort\" label/prefix."
        }
      },
      "required": [
        "doctype"
      ],
      "additionalProperties": false,
      "description": "Props for `<SortBy>`. The ordering rules are a separate `v-model` (`Sort[]`)."
    }
  }
}