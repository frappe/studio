{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommentComposerProps": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        },
        "uploadFunction": {
          "type": "object",
          "description": "Inline-image upload handler passed to the editor; returns the editor's file shape."
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "description": "An"
          }
        }
      },
      "additionalProperties": false
    },
    "CommentComposerSlots": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "description": "Extra footer actions, beside the built-in attach button."
        }
      },
      "additionalProperties": false
    },
    "CommentComposerEmits": {
      "type": "object",
      "properties": {
        "submit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "file_name": {
                      "type": "string"
                    },
                    "file_url": {
                      "type": "string"
                    },
                    "file_type": {
                      "type": "string"
                    },
                    "file_size": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "file_name",
                    "file_url",
                    "file_type"
                  ],
                  "additionalProperties": false,
                  "description": "A file as returned by FileUploader's `success` event."
                }
              }
            },
            "required": [
              "body",
              "attachments"
            ],
            "additionalProperties": false,
            "title": "payload"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Fires with the built payload; the host performs the send, then `reset()`."
        },
        "remove-attachment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "file_url": {
                "type": "string"
              },
              "file_type": {
                "type": "string"
              },
              "file_size": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "file_name",
              "file_url",
              "file_type"
            ],
            "additionalProperties": false,
            "description": "A file as returned by FileUploader's `success` event.",
            "title": "file"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Only on explicit chip removal (so the host can delete server-side)."
        }
      },
      "required": [
        "submit",
        "remove-attachment"
      ],
      "additionalProperties": false
    }
  }
}