{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ListViewShellProps": {
      "type": "object",
      "properties": {
        "doctype": {
          "type": "string",
          "description": "Doctype whose Meta drives the shell's fields/columns."
        }
      },
      "required": [
        "doctype"
      ],
      "additionalProperties": false,
      "description": "Props for `<ListViewShell>`."
    },
    "ListViewShellSlots": {
      "type": "object",
      "properties": {
        "toolbar": {
          "type": "object",
          "description": "Replaces the toolbar region (controls, actions)."
        },
        "table": {
          "type": "object",
          "description": "Replaces the table/body region."
        },
        "footer": {
          "type": "object",
          "description": "Replaces the footer region (pagination, counts)."
        }
      },
      "additionalProperties": false
    }
  }
}