{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommentItemProps": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "comment",
              "description": "discriminant → picks the renderer/slot"
            },
            "key": {
              "type": "string",
              "description": "v-for key + scroll target; prefix by type (e.g. `sla_breach:1`)"
            },
            "timestamp": {
              "type": "string"
            },
            "author": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "fullname": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "icon": {
              "type": [
                "string"
              ],
              "description": "lucide name or component; per-type default when absent"
            },
            "data": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "key",
            "data"
          ],
          "additionalProperties": false
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [
        "comment"
      ],
      "additionalProperties": false
    },
    "CommentItemSlots": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "description": "Replaces the row header (author, timestamp)."
        },
        "actions": {
          "type": "object",
          "description": "Trailing actions in the header."
        },
        "footer": {
          "type": "object",
          "description": "Replaces the row footer."
        }
      },
      "additionalProperties": false
    }
  }
}