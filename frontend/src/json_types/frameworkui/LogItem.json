{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LogItemProps": {
      "type": "object",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "log",
                  "description": "discriminant → picks the renderer/slot"
                },
                "key": {
                  "type": "string",
                  "description": "v-for key + scroll target; prefix by type (e.g. `sla_breach:1`)"
                },
                "timestamp": {
                  "type": "string"
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "fullname": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "icon": {
                  "type": [
                    "string"
                  ],
                  "description": "lucide name or component; per-type default when absent"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "subtype": {
                      "type": "string",
                      "enum": [
                        "like",
                        "assigned",
                        "assignment_completed",
                        "workflow",
                        "info",
                        "view",
                        "created",
                        "edited",
                        "shared",
                        "milestone"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "assignee": {
                      "type": "string",
                      "description": "assignee on assignment logs; bolded alongside the actor (backend-supplied)"
                    },
                    "assignees": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "set when consecutive assignment logs fold into one row; all bolded"
                    }
                  },
                  "required": [
                    "name",
                    "subtype",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "key",
                "data"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "attachment_log",
                  "description": "discriminant → picks the renderer/slot"
                },
                "key": {
                  "type": "string",
                  "description": "v-for key + scroll target; prefix by type (e.g. `sla_breach:1`)"
                },
                "timestamp": {
                  "type": "string"
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "fullname": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "icon": {
                  "type": [
                    "string"
                  ],
                  "description": "lucide name or component; per-type default when absent"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "added",
                        "removed"
                      ]
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "fileUrl": {
                      "type": "string"
                    },
                    "isPrivate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "action",
                    "fileName",
                    "isPrivate"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "key",
                "data"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "activity"
      ],
      "additionalProperties": false
    }
  }
}