{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LinkProps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "doctype": {
          "type": "string"
        },
        "filters": {
          "type": "object",
          "additionalProperties": {}
        },
        "creatable": {
          "type": "boolean"
        },
        "redirectable": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        }
      },
      "required": [
        "doctype"
      ],
      "additionalProperties": false
    },
    "LinkSlots": {
      "type": "object",
      "properties": {
        "suffix": {
          "type": "object",
          "description": "Content rendered in the input's suffix region. Scoped."
        },
        "item-create": {
          "type": "object",
          "description": "Custom render for the \"Create New\" option; receives the typed query."
        }
      },
      "additionalProperties": false
    },
    "LinkEmits": {
      "type": "object",
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "query"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "redirect": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "value"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "edit": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "value"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "create",
        "redirect",
        "edit"
      ],
      "additionalProperties": false
    }
  }
}