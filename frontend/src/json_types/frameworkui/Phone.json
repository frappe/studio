{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PhoneProps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Visual size of the control."
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline"
          ],
          "description": "Style variant of the control."
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text for the number input."
        },
        "disabled": {
          "type": "boolean",
          "description": "Disables the country picker and the number input."
        }
      },
      "additionalProperties": false
    },
    "PhoneSlots": {
      "type": "object",
      "properties": {
        "label": {
          "type": "object",
          "description": "Overrides the rendered label content. Receives `{ required }`."
        },
        "description": {
          "type": "object",
          "description": "Overrides the rendered description content."
        },
        "suffix": {
          "type": "object",
          "description": "Content rendered at the end of the control shell."
        }
      },
      "additionalProperties": false
    }
  }
}