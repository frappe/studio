{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TabButtonsProps": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "icon": {
                "type": [
                  "string"
                ],
                "description": "Icon-only tab; `label` becomes accessibility text."
              },
              "iconLeft": {
                "type": [
                  "string"
                ],
                "description": "Leading accent icon, rendered next to the visible label."
              },
              "iconRight": {
                "type": [
                  "string"
                ],
                "description": "Trailing accent icon, rendered next to the visible label."
              },
              "active": {
                "type": "boolean"
              },
              "disabled": {
                "type": "boolean"
              },
              "tooltip": {
                "type": "string"
              },
              "class": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                ]
              },
              "route": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ],
                "description": "Renders the tab as a `<RouterLink>` to the given target."
              },
              "href": {
                "type": "string",
                "description": "Renders the tab as an `<a href>`, opens in a new tab."
              },
              "onClick": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "description": "List of options to render."
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "icon": {
                "type": [
                  "string"
                ],
                "description": "Icon-only tab; `label` becomes accessibility text."
              },
              "iconLeft": {
                "type": [
                  "string"
                ],
                "description": "Leading accent icon, rendered next to the visible label."
              },
              "iconRight": {
                "type": [
                  "string"
                ],
                "description": "Trailing accent icon, rendered next to the visible label."
              },
              "active": {
                "type": "boolean"
              },
              "disabled": {
                "type": "boolean"
              },
              "tooltip": {
                "type": "string"
              },
              "class": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                ]
              },
              "route": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ],
                "description": "Renders the tab as a `<RouterLink>` to the given target."
              },
              "href": {
                "type": "string",
                "description": "Renders the tab as an `<a href>`, opens in a new tab."
              },
              "onClick": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "deprecated": "Use `options` instead."
        },
        "modelValue": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "subtle",
            "ghost",
            "underline",
            "browser-tab"
          ]
        },
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md"
          ]
        },
        "vertical": {
          "type": "boolean"
        },
        "direction": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "description": "Edge the active browser tab attaches to. Only used when `type='browser-tab'` and `vertical`."
        }
      },
      "additionalProperties": false
    },
    "TabButtonsEmits": {
      "type": "object",
      "properties": {
        "update:modelValue": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "not": {}
              }
            ],
            "title": "value"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "update:modelValue"
      ],
      "additionalProperties": false
    }
  }
}