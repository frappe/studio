{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FileUploaderProps": {
      "type": "object",
      "properties": {
        "fileTypes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Accepted file types passed to the native file input."
        },
        "uploadArgs": {
          "type": "object",
          "properties": {
            "private": {
              "type": "boolean"
            },
            "is_private": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "string",
                  "const": "0"
                },
                {
                  "type": "string",
                  "const": "1"
                }
              ]
            },
            "folder": {
              "type": "string"
            },
            "file_url": {
              "type": "string"
            },
            "doctype": {
              "type": "string"
            },
            "docname": {
              "type": "string"
            },
            "fieldname": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "upload_endpoint": {
              "type": "string"
            },
            "optimize": {
              "type": "boolean"
            },
            "max_width": {
              "type": "number"
            },
            "max_height": {
              "type": "number"
            },
            "params": {
              "type": "object"
            },
            "signal": {
              "type": "object",
              "properties": {
                "aborted": {
                  "type": "boolean"
                },
                "onabort": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {}
              },
              "required": [
                "aborted",
                "onabort",
                "reason"
              ],
              "additionalProperties": false
            },
            "onProgress": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "description": "Additional upload options passed to Frappe's upload endpoint. `private` / `is_private` override the component's `isPrivate` default."
        },
        "validateFile": {
          "type": "object",
          "description": "Optional validation hook. Return a message or Error to block upload."
        }
      },
      "additionalProperties": false
    },
    "FileUploaderEmits": {
      "type": "object",
      "properties": {
        "success": {
          "type": "array",
          "items": {
            "title": "data"
          },
          "minItems": 1,
          "maxItems": 1,
          "deprecated": "Kept for compatibility through v1.x."
        },
        "failure": {
          "type": "array",
          "items": {
            "title": "error"
          },
          "minItems": 1,
          "maxItems": 1,
          "deprecated": "Kept for compatibility through v1.x."
        }
      },
      "required": [
        "success",
        "failure"
      ],
      "additionalProperties": false
    }
  }
}