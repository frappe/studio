{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SettingsDialogProps": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl",
            "4xl",
            "5xl",
            "6xl",
            "7xl"
          ],
          "description": "Max-width size of the dialog."
        },
        "shortcut": {
          "type": "boolean",
          "description": "Enable the Cmd/Ctrl+Shift+, shortcut that toggles the dialog."
        },
        "unmountOnHide": {
          "type": "boolean",
          "description": "Unmount a panel's content when its tab is inactive (reka-ui default: true). Set false to keep visited panels mounted (hidden) — preserves their state and scroll position across tab switches at the cost of memory."
        }
      },
      "additionalProperties": false
    },
    "SettingsDialogEmits": {
      "type": "object",
      "properties": {
        "update:modelValue": {
          "type": "array",
          "items": {
            "type": "boolean",
            "title": "value"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Fired when the dialog is opened or closed."
        }
      },
      "required": [
        "update:modelValue"
      ],
      "additionalProperties": false
    }
  }
}