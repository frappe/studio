                          "type": "object"
                        }
                      ],
                      "description": "Navigation target. When set the row's main area renders as a router link; otherwise it renders as a button. A click still invokes `onClick`."
                    },
                    "active": {
                      "type": "boolean",
                      "description": "Marks the row active (`data-state=\"active\"`). When omitted, active state is inferred by matching `to` against the current route."
                    },
                    "isActive": {
                      "type": "boolean",
                      "deprecated": "Use `active`. Alias kept for the config-object path."
