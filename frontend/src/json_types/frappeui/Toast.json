{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ToastProps": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "Controls whether the toast is visible (required)"
        },
        "message": {
          "type": "string",
          "description": "Message content rendered inside the toast"
        },
        "type": {
          "type": "string",
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ],
          "description": "Visual tone of the toast"
        },
        "duration": {
          "type": "number",
          "description": "Auto-dismiss duration in milliseconds"
        },
        "icon": {
          "type": "string",
          "description": "Optional custom icon rendered before the message"
        },
        "closable": {
          "type": "boolean",
          "description": "Whether the close button is shown"
        },
        "action": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "Label shown for the toast action"
            },
            "altText": {
              "type": "string",
              "description": "Accessible text announced for the action control"
            },
            "onClick": {
              "type": "object",
              "description": "Callback invoked when the action is triggered"
            }
          },
          "required": [
            "label",
            "onClick"
          ],
          "additionalProperties": false,
          "description": "Optional action rendered on the right side of the toast"
        }
      },
      "required": [
        "open"
      ],
      "additionalProperties": false
    }
  }
}