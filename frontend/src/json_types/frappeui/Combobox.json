          },
          "description": "Options rendered in the popover."
        },
        "trigger": {
          "type": "string",
          "enum": [
            "input",
            "button"
          ],
          "description": "Shape of the trigger.\n- `'input'` (default): user types directly into the trigger\n- `'button'`: render a button trigger; search input moves into the   popover header. Label + prefix auto-derive from the selected option."
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline",
            "ghost"
          ],
          "description": "Visual style of the combobox."
        },
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Size of the trigger and option rows."
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text shown when no value is selected."
        },
        "disabled": {
          "type": "boolean",
          "description": "Disables the combobox."
        },
        "open": {
          "type": "boolean",
          "description": "Controls the popover visibility."
        },
        "openOnFocus": {
          "type": "boolean",
          "description": "Opens the popover when the input receives focus."
        },
        "openOnClick": {
          "type": "boolean",
          "description": "Opens the popover when the input is clicked."
        },
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "description": "Preferred popover side."
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "description": "Preferred popover alignment."
        },
        "offset": {
          "type": "number",
          "description": "Gap between trigger and content."
        },
        "portalTo": {
          "type": [
            "string"
          ],
          "description": "Teleport target for the popover content."
        },
        "allowCustomValue": {
          "type": "boolean",
          "description": "Free-form acceptance: the typed query is accepted as the model value when nothing matches, and external `modelValue` updates with unknown strings are preserved. The combobox also renders a built-in \"Create X\" row as a click affordance.\n\nFor richer create-new UX (custom label / icon / persistence callback), prefer a `type: 'custom'` option with `condition` instead — see the Create New story. The two are independent and can be combined."
        },
        "loading": {
          "type": "boolean",
          "description": "Replaces the results with a loading state."
        },
        "emptyText": {
          "type": "string",
          "description": "Fallback empty-state copy."
        },
        "placement": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "deprecated": "use `align` instead; `placement` is kept as a back-compat alias",
          "description": "Alignment of the popover along the trigger edge."
        }
      },
      "additionalProperties": false
    },
    "ComboboxSlots": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "object",
          "description": "Fully custom trigger renderer."
        },
        "label": {
          "type": "object",
          "description": "Overrides the rendered label content. Receives `{ required }`."
        },
        "description": {
          "type": "object",
          "description": "Overrides the rendered description content."
        },
        "prefix": {
          "type": "object",
          "description": "Content rendered before the default input. Receives the same shape as the other control slots."
        },
        "suffix": {
          "type": "object",
          "description": "Content rendered after the input (input mode) or label (button mode). Providing this slot **replaces the default chevron** — render your own fallback (e.g. the chevron) when your slot content is conditional. Common use: an inline clear button. Use `@click.stop` and `@pointerdown.stop` so the press doesn't toggle the popover."
        },
        "item-prefix": {
          "type": "object",
          "description": "Shared content rendered before the standard row label."
        },
        "item-label": {
          "type": "object",
          "description": "Shared content rendered for the standard row label area."
        },
        "item-suffix": {
          "type": "object",
          "description": "Shared content rendered after the standard row label area."
        },
        "item": {
          "type": "object",
          "description": "Replaces the entire row."
        },
        "group-label": {
          "type": "object",
          "description": "Custom renderer for group labels."
        },
        "empty": {
          "type": "object",
          "description": "Fallback content rendered when there are no results."
        },
        "footer": {
          "type": "object",
          "description": "Content rendered after the list. Stays pinned below the scrollable options."
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "not": {}
          }
        ]
      }
    },
