                      "string"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  },
                  "slot": {
                    "type": "string"
                  },
                  "slots": {
                    "type": "object",
                    "description": "Per-item inline slot implementations for the row shell."
                  },
                  "slotName": {
                    "type": "string",
                    "deprecated": "use `slot`"
                  },
                  "onClick": {
                    "type": "object"
                  },
                  "keepOpen": {
                    "type": "boolean"
                  },
                  "condition": {
                    "type": "object"
                  },
                  "render": {
                    "anyOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "object"
                      }
                    ],
