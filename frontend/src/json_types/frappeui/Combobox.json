                  }
                },
                "required": [
                  "type",
                  "key",
                  "label",
                  "onClick"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "group": {
                    "type": "string"
                  },
                  "hideLabel": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "option"
                            },
                            "label": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            },
                            "icon": {
