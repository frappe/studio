{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PopoverProps": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "Controls visibility (v-model:open)."
        },
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "description": "Side of the trigger to render the content on."
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "description": "Alignment of the content along the chosen side."
        },
        "offset": {
          "type": "number",
          "description": "Distance in px between the trigger and the content."
        },
        "portalTo": {
          "type": [
            "string"
          ],
          "description": "Where to portal the content."
        },
        "collisionPadding": {
          "type": "number",
          "description": "Padding in px kept from the viewport edge during collision handling."
        },
        "dismissible": {
          "type": "boolean",
          "description": "Whether the popover closes on outside interaction (click/focus)."
        },
        "matchTriggerWidth": {
          "type": "boolean",
          "description": "Whether the content's min-width matches the trigger width."
        },
        "bare": {
          "type": "boolean",
          "description": "Render `#default` without the panel shell (no background, border, shadow, or rounding). The content brings its own surface. Mirrors Dialog's `bare`."
        },
        "arrow": {
          "type": "boolean",
          "description": "Render a small arrow pointing at the trigger. Styled to match the panel surface."
        },
        "show": {
          "type": "boolean",
          "deprecated": "Use `open` / `v-model:open`."
        },
        "trigger": {
          "type": "string",
          "enum": [
            "click",
            "hover"
          ],
          "deprecated": "Use `<HoverCard>` for hover behavior."
        },
        "hoverDelay": {
          "type": "number",
          "deprecated": "Use `<HoverCard>` (`hoverDelay`, in seconds)."
        },
        "leaveDelay": {
          "type": "number",
          "deprecated": "Use `<HoverCard>` (`leaveDelay`, in seconds)."
        },
        "placement": {
          "type": "string",
          "enum": [
            "top-start",
            "top-end",
            "bottom-start",
            "bottom-end",
            "right-start",
            "right-end",
            "left-start",
            "left-end",
            "top",
            "bottom",
            "right",
            "left"
          ],
          "description": "Legacy placement union (deprecated — use `side` + `align`).",
          "deprecated": "Use `side` + `align`."
        },
        "popoverClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          ],
          "deprecated": "Use the `data-slot` CSS hooks (no-op)."
        },
        "transition": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "default",
            null
          ],
          "deprecated": "Motion is now built in (no-op)."
        },
        "hideOnBlur": {
          "type": "boolean",
          "deprecated": "Use `dismissible`."
        },
        "matchTargetWidth": {
          "type": "boolean",
          "deprecated": "Use `matchTriggerWidth`."
        }
      },
      "additionalProperties": false
    },
    "PopoverEmits": {
      "type": "object",
      "additionalProperties": false
    }
  }
}